[sub_resource type="GDScript" id="GDScript_jjvhh"]
script/source = "extends Node2D

@onready var inventory_ui: Control = $CanvasLayer/InventoryUI
@onready var player: CharacterBody2D = $Player
@onready var health_label: Label = $CanvasLayer/Panel/VBoxContainer/Health_Label

func _ready() -> void:
	health_label.text = \"%d/%d\" % [player.health, player.max_health]

func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"inventory_toggle\"):
		inventory_ui.visible = not inventory_ui.visible
		if inventory_ui.visible:
			inventory_ui.refresh(player.inventory)
"

[sub_resource type="CanvasItemMaterial" id="CanvasItemMaterial_jjvhh"]

